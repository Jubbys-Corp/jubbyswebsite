<?xml version="1.0" encoding="utf-8"?>
<!--
  IIS config for the Plesk (Windows) host - copied into dist/ by Vite.
  The site is a single-page app: every path that is not a real file must be
  answered with index.html so the client-side router can take over
  (/hakkimizda, /sss, /iletisim, /haberler). Needs the IIS URL Rewrite module,
  which Plesk for Windows ships with.

  Kept deliberately small: anything that is also set server-wide by Plesk
  (headers, compression, cache locks) would make IIS refuse the whole file
  with a 500.19 configuration error.
-->
<configuration>
  <system.webServer>
    <rewrite>
      <rules>
        <!-- canonical host: only for the real domain, so the temporary
             *.plesk.page address keeps working while DNS is still elsewhere -->
        <rule name="www to apex" stopProcessing="true">
          <match url=".*" />
          <conditions>
            <add input="{HTTP_HOST}" pattern="^www\.jubbys\.com$" />
          </conditions>
          <action type="Redirect" url="https://jubbys.com/{R:0}" redirectType="Permanent" />
        </rule>
        <rule name="http to https" stopProcessing="true">
          <match url=".*" />
          <conditions>
            <add input="{HTTP_HOST}" pattern="^jubbys\.com$" />
            <add input="{HTTPS}" pattern="off" />
          </conditions>
          <action type="Redirect" url="https://jubbys.com/{R:0}" redirectType="Permanent" />
        </rule>

        <!-- real files and folders are served as they are, everything else is the app -->
        <rule name="SPA fallback" stopProcessing="true">
          <match url=".*" />
          <conditions logicalGrouping="MatchAll">
            <add input="{REQUEST_FILENAME}" matchType="IsFile" negate="true" />
            <add input="{REQUEST_FILENAME}" matchType="IsDirectory" negate="true" />
          </conditions>
          <action type="Rewrite" url="/index.html" />
        </rule>
      </rules>
    </rewrite>

    <staticContent>
      <remove fileExtension=".webp" />
      <mimeMap fileExtension=".webp" mimeType="image/webp" />
      <remove fileExtension=".webmanifest" />
      <mimeMap fileExtension=".webmanifest" mimeType="application/manifest+json" />
    </staticContent>
  </system.webServer>
</configuration>
